// DDS IDL definitions for the passenger-intent autonomous collaboration system.
// These types correspond to the virtual DDS topics used by VirtualDDSScenarioDemo
// and the comparative experiment in RouteFusionExperiment.

module urban {

  typedef sequence<string> StringSeq;

  struct Header {
    string message_id;
    string source_id;
    string target_id;
    string timestamp_iso8601;
    string frame_id;
    unsigned long sequence;
  };

  struct MissionCommand {
    Header header;
    string natural_language;
    string destination;
    string urgency;          // LOW, MEDIUM, HIGH
    string preference;       // TIME_FIRST, SAFE_FIRST, BALANCED
    StringSeq requested_capabilities;
    StringSeq publish_topics;
    StringSeq subscribe_topics;
    string dsl_contract;
  };

  struct VehicleTelemetry {
    Header header;
    string vehicle_role;     // EGO_AUTONOMOUS_VEHICLE, PEER_AUTONOMOUS_VEHICLE
    double position_x_m;
    double position_y_m;
    double speed_mps;
    double heading_deg;
    double battery_pct;
    double road_friction;
    string traffic_signal;
    string road_event;
  };

  struct EnvironmentPerception {
    Header header;
    string observer_type;    // UAV, RSU, VEHICLE, BACKBONE
    string event_type;
    double confidence;
    double risk_score;
    double visibility_m;
    double wind_speed_mps;
    unsigned long pedestrian_count;
    string evidence_summary;
  };

  struct RouteAdvice {
    Header header;
    string source_type;      // EGO_VEHICLE, PEER_VEHICLE, UAV, RSU, COMPLIANT_BACKBONE
    string destination;
    string route_candidate;
    double risk_score;
    double confidence;
    double estimated_time_min;
    string advice_reason;
    StringSeq required_topics;
  };

  struct RsuRoadEvent {
    Header header;
    string road_event;
    string traffic_signal;
    unsigned long pedestrian_count;
    double rsu_load;
    string recommended_route;
    double risk_score;
    double confidence;
  };

  struct CompliantNetworkContext {
    Header header;
    string link_mode;        // approved_satcom, 5g_v2x, industry_private_network, rsu_backhaul
    double link_health;
    double private_5g_signal;
    double rsu_load;
    double expected_latency_ms;
    string recommended_route;
    double risk_score;
    double confidence;
  };

  struct RouteDecision {
    Header header;
    string decision_owner;
    string autonomy_mode;    // vehicle_self_decision_after_dds_consensus
    string final_route;
    double final_risk_score;
    double confidence;
    StringSeq advice_sources;
    string passenger_explanation;
    string fusion_reason;
  };

  struct QosObservation {
    Header header;
    string qos_profile;      // reliable_keep_last, best_effort_sensor_stream
    unsigned long published_count;
    unsigned long delivered_count;
    unsigned long dropped_count;
    unsigned long retry_count;
    unsigned long stale_count;
    double average_latency_ms;
    double delivered_ratio;
  };

  struct RouteFusionExperimentResult {
    Header header;
    string qos_mode;
    string latency_profile;
    string conflict_profile;
    unsigned long total_advice;
    unsigned long delivered_advice;
    unsigned long dropped_advice;
    unsigned long retry_count;
    unsigned long stale_count;
    double average_latency_ms;
    double delivered_ratio;
    double route_stability;
    string final_route;
    double final_risk_score;
    double confidence;
  };
};

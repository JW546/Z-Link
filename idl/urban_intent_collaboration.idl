// DDS IDL definitions for the passenger-intent autonomous collaboration system.
// These types correspond to the virtual DDS topics used by VirtualDDSScenarioDemo
// and the comparative experiment in RouteFusionExperiment.

module urban {

  typedef string<64> IdString;
  typedef string<256> TextString;
  typedef string<2048> ContractString;

  struct Header {
    IdString message_id;
    IdString source_id;
    IdString target_id;
    IdString timestamp_iso8601;
    IdString frame_id;
    unsigned long sample_sequence;
  };

  struct MissionCommand {
    Header header;
    TextString natural_language;
    TextString destination;
    IdString urgency;          // LOW, MEDIUM, HIGH
    IdString preference;       // TIME_FIRST, SAFE_FIRST, BALANCED
    sequence<TextString, 32> requested_capabilities;
    sequence<TextString, 32> publish_topics;
    sequence<TextString, 32> subscribe_topics;
    ContractString dsl_contract;
  };

  struct VehicleTelemetry {
    Header header;
    IdString vehicle_role;     // EGO_AUTONOMOUS_VEHICLE, PEER_AUTONOMOUS_VEHICLE
    double position_x_m;
    double position_y_m;
    double speed_mps;
    double heading_deg;
    double battery_pct;
    double road_friction;
    IdString traffic_signal;
    TextString road_event;
  };

  struct EnvironmentPerception {
    Header header;
    IdString observer_type;    // UAV, RSU, VEHICLE, BACKBONE
    IdString event_type;
    double confidence;
    double risk_score;
    double visibility_m;
    double wind_speed_mps;
    unsigned long pedestrian_count;
    TextString evidence_summary;
  };

  struct RouteAdvice {
    Header header;
    IdString source_type;      // EGO_VEHICLE, PEER_VEHICLE, UAV, RSU, COMPLIANT_BACKBONE
    TextString destination;
    IdString route_candidate;
    double risk_score;
    double confidence;
    double estimated_time_min;
    TextString advice_reason;
    sequence<TextString, 32> required_topics;
  };

  struct RsuRoadEvent {
    Header header;
    TextString road_event;
    IdString traffic_signal;
    unsigned long pedestrian_count;
    double rsu_load;
    IdString recommended_route;
    double risk_score;
    double confidence;
  };

  struct CompliantNetworkContext {
    Header header;
    IdString link_mode;        // approved_satcom, 5g_v2x, industry_private_network, rsu_backhaul
    double link_health;
    double private_5g_signal;
    double rsu_load;
    double expected_latency_ms;
    IdString recommended_route;
    double risk_score;
    double confidence;
  };

  struct RouteDecision {
    Header header;
    IdString decision_owner;
    IdString autonomy_mode;    // vehicle_self_decision_after_dds_consensus
    IdString final_route;
    double final_risk_score;
    double confidence;
    sequence<TextString, 32> advice_sources;
    TextString passenger_explanation;
    TextString fusion_reason;
  };

  struct QosObservation {
    Header header;
    IdString qos_profile;      // reliable_keep_last, best_effort_sensor_stream
    unsigned long published_count;
    unsigned long delivered_count;
    unsigned long dropped_count;
    unsigned long retry_count;
    unsigned long stale_count;
    double average_latency_ms;
    double delivered_ratio;
  };

  struct RouteFusionExperimentResult {
    Header header;
    IdString qos_mode;
    IdString latency_profile;
    IdString conflict_profile;
    unsigned long total_advice;
    unsigned long delivered_advice;
    unsigned long dropped_advice;
    unsigned long retry_count;
    unsigned long stale_count;
    double average_latency_ms;
    double delivered_ratio;
    double route_stability;
    IdString final_route;
    double final_risk_score;
    double confidence;
  };

  struct RuntimeIntentContract {
    Header header;
    IdString mission_id;
    TextString natural_language;
    ContractString dsl_contract;
    sequence<IdString, 16> required_agents;
    unsigned long default_status_interval_ms;
  };

  struct RuntimeAgentStatus {
    Header header;
    IdString agent_id;
    IdString role;            // UAV, EGO_CAR, PEER_CAR
    IdString protocol;        // DJI-STYLE, ROS2-DDS, GENERIC-PRIVATE-JSON
    IdString route;
    double position_x_m;
    double position_y_m;
    double position_z_m;
    double speed_mps;
    double battery_pct;
    double publish_rate_hz;
    IdString mission_status;
    IdString link_id;
    IdString message_type;
    unsigned long message_instance_id;
    unsigned long stream_id;
    boolean ack_required;
    unsigned long valid_time_ms;
    double latency_ms;
    IdString checksum;
  };

  struct ProtocolNativeFrame {
    Header header;
    IdString agent_id;
    IdString role;
    IdString protocol;
    IdString unified_topic;
    ContractString native_payload_json;
    TextString compatibility_note;
    IdString message_type;
    unsigned long message_instance_id;
    unsigned long stream_id;
    boolean ack_required;
    unsigned long valid_time_ms;
    double latency_ms;
    IdString checksum;
  };

  struct ConflictEvent {
    Header header;
    IdString conflict_id;
    IdString conflict_type;
    sequence<IdString, 16> involved_agents;
    IdString route;
    double severity;
    TextString explanation;
  };

  struct ReplanningRequest {
    Header header;
    IdString mission_id;
    TextString reason;
    TextString request;
    IdString requested_by;
  };

  struct PolicyEvaluationReport {
    Header header;
    IdString mission_id;
    IdString winner;
    double dijkstra_risk;
    double greedy_risk;
    double cooperative_risk;
    unsigned long conflict_count;
    TextString explanation;
  };
};
